{
  "name": "liftwatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite web --host 0.0.0.0",
    "build": "vite build web --outDir ../dist",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:contracts": "python -m unittest discover -s tests -p 'test_*.py' -v",
    "check:contract": "python -m py_compile contracts/liftwatch.py",
    "schema:studionet": "node scripts/schema-check.mjs"
  },
  "dependencies": {
    "genlayer-stable": "npm:genlayer-js@1.1.8"
  },
  "devDependencies": {
    "vite": "7.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
